# NOFX Environment Variables Template
# Copy this file to .env and modify the values as needed

# ===========================================
# Server Configuration
# ===========================================

# Backend API server port
NOFX_BACKEND_PORT=8080

# Interface the API binds to. DEFAULT (unset) = 127.0.0.1, loopback only.
# The API carries broker/model credentials and full trader control, so it should
# not be reachable off-host. Set this to 0.0.0.0 ONLY behind a firewall or a
# reverse proxy that terminates TLS and authenticates — a non-loopback value
# logs a warning at boot.
# API_SERVER_HOST=127.0.0.1

# Frontend web interface port
NOFX_FRONTEND_PORT=3000

# Timezone
NOFX_TIMEZONE=Asia/Shanghai

# DESTRUCTIVE escape hatch: POST /api/reset-account deletes EVERY user, trader
# and strategy. It requires a valid JWT, this flag, and a
# {"confirm":"RESET-ALL-DATA"} body. Leave unset (disabled) in normal operation.
# ALLOW_ACCOUNT_RESET=1

# ===========================================
# Authentication (Required)
# ===========================================

# JWT signing secret (any random string, at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-this-in-production

# ===========================================
# Encryption Keys (Required)
# ===========================================

# AES-256 data encryption key (Base64 encoded, 32 bytes)
# Used for encrypting sensitive data in database (API keys, secrets)
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# RSA private key for client-server encryption (PEM format)
# Used for end-to-end encryption of sensitive data from browser
# Generate with: openssl genrsa 2048
# Note: Replace newlines with \n for single-line format
RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----

# ===========================================
# Security Options
# ===========================================

# Transport encryption for API keys (default: false)
# When enabled, browser uses Web Crypto API to encrypt API keys before sending
# Requires HTTPS or localhost to work
# Set to true for enhanced security (HTTPS required)
# Set to false for easier deployment (HTTP/IP access allowed)
TRANSPORT_ENCRYPTION=false

# ===========================================
# Optional: External Services
# ===========================================

DB_TYPE=postgres
DB_HOST=10.
DB_PORT=5432
DB_USER=nofx_user
DB_PASSWORD=
DB_NAME=nofx
DB_SSLMODE=disable


# Database configuration - SQLite (default)
DB_TYPE=sqlite
DB_PATH=data/data.db

# ===========================================
# NQ futures (Databento + NinjaTrader)
# ===========================================

# Trading mode: "crypto" (default) or "futures" to enable NQ path
TRADING_MODE=crypto

# Databento Historical API key — https://databento.com/portal/keys
# Auth model: HTTP Basic, key as username, empty password
DATABENTO_API_KEY=

# Databento dataset code (GLBX.MDP3 covers all CME Globex products)
DATABENTO_DATASET=GLBX.MDP3

# NinjaTrader transport: "tcp" = the real-time TCP bridge (REQUIRED for live
# bars + execution; the CSV path is deprecated). Must live HERE in .env —
# systemd services and cron never read ~/.bashrc, so a value set only there
# silently falls back to CSV.
NT_TRANSPORT=tcp

# NinjaTrader CSV bridge data directory (WSL2 view of Windows path)
# Legacy/deprecated path — only used when NT_TRANSPORT is not "tcp"
# e.g. /mnt/c/Users/<your-windows-username>/NofxTrader/data
NINJATRADER_DATA_DIR=
# ── AI call timeout (incident 2026-08-18: hardcoded 180s decision cap killed
# DeepSeek reads mid-body once max_tokens was raised and reasoning responses
# started running 150s+; every timed-out call = a missed decision).
# ONE knob for executor AND planner. Canonical name below; the pre-existing
# AI_TIMEOUT_SECONDS is still honored when this is unset. Default 300.
#AI_HTTP_TIMEOUT_SECONDS=300

# ── Session-scoped last-entry / EOD-flat (P2 redesign 2026-08-18). Both are
# offsets in MINUTES BEFORE each session's end, per-session under
# day_plan.sessions[]: {"session":"ASIA","last_entry_offset_min":15,
# "eod_flat_offset_min":15}. Default 15. The old day-scoped 13:00 CT cutoff
# (blocked Asia evenings entirely) and the 14:45 CT flat literal are
# unreachable; see trader/auto_trader_clock.go sessionCutoffCT.

# ── Stale-bar grace (stale-bar dispatch 2026-08-19). A timeframe is stale only
# when the bar that SHOULD exist for the current period is missing:
# newest_open < floor(now/period)*period − period − grace. This is the delivery
# slack in SECONDS. Default 15. (The old 2×interval math was calibrated on
# END-stamped bars and lost one period of slack when stamps were corrected.)
#STALE_BAR_GRACE_S=15
