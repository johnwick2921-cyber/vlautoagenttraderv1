trader/f12_leg4.go:193:
trader/f12_leg4.go:194: // OrderSnapshotInterval is the AddOn's snapshot period N, RESOLVED (A11): env
trader/f12_leg4.go:195: // override first, else the default the AddOn also ships with. Leg 4 calls a
trader/f12_leg4.go:196: // book older than 2N stale.
trader/f12_leg4.go:197: func OrderSnapshotInterval() time.Duration {
trader/f12_leg4.go:198: 	if v := strings.TrimSpace(os.Getenv("NT8_ORDER_SNAPSHOT_SECS")); v != "" {
trader/f12_leg4.go:199: 		if n, err := strconv.Atoi(v); err == nil && n > 0 {
trader/f12_leg4.go:200: 			return time.Duration(n) * time.Second
trader/f12_leg4.go:201: 		}
trader/f12_leg4.go:202: 	}
trader/f12_leg4.go:203: 	return DefaultOrderSnapshotSecs * time.Second
trader/f12_leg4.go:204: }
trader/f12_leg4.go:205:
trader/f12_leg4.go:206: // DefaultOrderSnapshotSecs is the ONE definition of the snapshot period. The C#
