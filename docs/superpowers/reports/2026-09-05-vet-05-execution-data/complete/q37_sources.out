kernel/min_sl.go:18: // MinSLATRMultDefault is the shipped minimum stop width in 5m ATR(14) units.
kernel/min_sl.go:19: //
kernel/min_sl.go:20: // 0B (owner ruling 2026-09-02): 1.0 → 1.5. The 1.0 was [C] code-canon with no
kernel/min_sl.go:21: // citation (knob census). Round-7 research tests the day-trade range at
kernel/min_sl.go:22: // 1.5–2.5×ATR and finds stop-out rates above 60% on noise alone below 1.0×;
kernel/min_sl.go:23: // our own tape has 6 of 8 losers printing MAE beyond the stop and 15 of 27
kernel/min_sl.go:24: // losers stopped-too-tight. 1.5 is the bottom of the researched range, not the
kernel/min_sl.go:25: // middle — the deliberate first step from an uncited number to a cited one.
kernel/min_sl.go:26: //
kernel/min_sl.go:27: // This value is read by THREE gates: the arm-time gate
kernel/min_sl.go:28: // (trader/armed_executor.go), the AI-entry decision gate
kernel/min_sl.go:29: // (kernel/engine_position.go) and the planner's authoring WARNING
kernel/min_sl.go:30: // (trader/auto_trader_planner.go, ArmFeasibilityWarnings). Raising it tightens
kernel/min_sl.go:31: // all three at once — intended: the same floor everywhere is the point.
kernel/min_sl.go:32: //
kernel/min_sl.go:33: // Env MIN_SL_ATR_MULT overrides; 0 disables the gate entirely.
kernel/min_sl.go:34: const MinSLATRMultDefault = 1.5
kernel/min_sl.go:35:
kernel/min_sl.go:36: // MinSLTickClearance is the level-clearance leg: a cited-scenario stop must
kernel/min_sl.go:37: // sit at least this many ticks BEYOND the anchor level/zone far edge. Stops
kernel/min_sl.go:38: // parked exactly at a level get run by the sweep; 2 ticks of clearance puts
kernel/min_sl.go:39: // the stop on the far side of the resting orders.
kernel/min_sl.go:40: const MinSLTickClearance = 2
kernel/min_sl.go:41:
kernel/min_sl.go:42: // MinSLATRMult resolves the min-SL ATR multiplier (env MIN_SL_ATR_MULT,
kernel/min_sl.go:43: // default 1.0; 0 = gate off).
kernel/min_sl.go:44: func MinSLATRMult() float64 {
kernel/min_sl.go:45: 	if v := os.Getenv("MIN_SL_ATR_MULT"); v != "" {
kernel/min_sl.go:46: 		if f, err := strconv.ParseFloat(strings.TrimSpace(v), 64); err == nil && f >= 0 {
kernel/min_sl.go:47: 			return f
kernel/min_sl.go:48: 		}
kernel/min_sl.go:49: 	}
kernel/min_sl.go:50: 	return MinSLATRMultDefault
