ninjascript/VLTraderTCPClient.cs:2352:         private void RunHeartbeatLoop(CancellationToken ct)
ninjascript/VLTraderTCPClient.cs:2353:         {
ninjascript/VLTraderTCPClient.cs:2354:             int beatCount = 0;
ninjascript/VLTraderTCPClient.cs:2355:             while (!ct.IsCancellationRequested)
ninjascript/VLTraderTCPClient.cs:2356:             {
ninjascript/VLTraderTCPClient.cs:2357:                 Thread.Sleep(HEARTBEAT_INTERVAL_MS);
ninjascript/VLTraderTCPClient.cs:2358:                 if (ct.IsCancellationRequested) return;
ninjascript/VLTraderTCPClient.cs:2359:                 WriteEnvelope("heartbeat", new Dictionary<string, object>
ninjascript/VLTraderTCPClient.cs:2360:                 {
ninjascript/VLTraderTCPClient.cs:2361:                     ["build_id"] = VL_BUILD_ID,
ninjascript/VLTraderTCPClient.cs:2362:                 });
ninjascript/VLTraderTCPClient.cs:2363:
ninjascript/VLTraderTCPClient.cs:2364:                 // F12 — the PERIODIC working-order snapshot. It rides this loop
ninjascript/VLTraderTCPClient.cs:2365:                 // because HEARTBEAT_INTERVAL_MS and ORDER_SNAPSHOT_INTERVAL_MS are
ninjascript/VLTraderTCPClient.cs:2366:                 // both 30s; a second thread on the same period would buy nothing
ninjascript/VLTraderTCPClient.cs:2367:                 // but another thing to get out of step. If the periods ever
ninjascript/VLTraderTCPClient.cs:2368:                 // diverge this needs its own timer, and the constants sit beside
ninjascript/VLTraderTCPClient.cs:2369:                 // each other so that is visible.
ninjascript/VLTraderTCPClient.cs:2370:                 try { SendOrderSnapshot(account, "periodic"); }
ninjascript/VLTraderTCPClient.cs:2371:                 catch (Exception exSnap)
ninjascript/VLTraderTCPClient.cs:2372:                 {
ninjascript/VLTraderTCPClient.cs:2373:                     LogWarn("RunHeartbeatLoop: order_snapshot failed (will retry): " + exSnap.Message);
ninjascript/VLTraderTCPClient.cs:2374:                 }
