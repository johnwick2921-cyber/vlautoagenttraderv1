kernel/session_registry.go:102: 				Enabled:       false,
kernel/session_registry.go:103: 			},
kernel/session_registry.go:104: 			{
kernel/session_registry.go:105: 				Name:          SessionNY,
kernel/session_registry.go:106: 				WindowStartCT: "08:30",
