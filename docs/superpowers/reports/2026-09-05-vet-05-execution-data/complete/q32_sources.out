1272: 		PlanID:             r.PlanID,
1273: 		PlanVersion:        r.Version,
1274: 		PlanTradeDate:      tradeDate,
1275: 		PlanSession:        r.Session,
1276: 		CitedScenarioID:    r.Scenario,
1277: 		CreatedAt:          nowMs,
1278: 		UpdatedAt:          nowMs,
1279: 	}
1280: 	if err := at.store.Position().CreateOpenPosition(row); err != nil {
1281: 		at.logWarnf("🧩 armed fill %s materialize OPEN failed: %v", r.Scenario, err)
1282: 		return
1283: 	}
1284: 	at.logInfof("🧩 armed fill %s @ %.2f materialized OPEN (source=armed_entry — sub-60s round-trips are ledger-visible)", r.Scenario, u.FillPrice)
