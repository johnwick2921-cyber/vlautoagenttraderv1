198: 	err := s.db.Where("plan_id = ? AND scenario = ? AND leg_index = ?", row.PlanID, row.Scenario, row.LegIndex).
199: 		Order("CASE WHEN state IN ('armed','working') THEN 0 ELSE 1 END, placement_seq DESC, id DESC").First(&existing).Error
200: 	if err == nil {
201: 		// D5 — a WORKING row is a LIVE BROKER ORDER. Rewriting its prices in
202: 		// place overwrote the slot and lost the brackets (rows 582, 585): the
