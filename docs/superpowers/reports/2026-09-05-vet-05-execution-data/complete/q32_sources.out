145: // EntryGate runs the single canonical entry gate chain. Empty reason = allow.
146: func EntryGate(in EntryIntent) (reason string, refused bool) {
147: 	side := strings.ToLower(strings.TrimSpace(in.Action))
148: 	if side == "open_long" {
149: 		side = "long"
150: 	} else if side == "open_short" {
151: 		side = "short"
152: 	}
153: 	if side != "long" && side != "short" {
154: 		return "", false // not an entry intent — not this gate's job
155: 	}
