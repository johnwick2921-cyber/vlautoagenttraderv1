300: // ON AND its value is configured (>0); a tripped guardrail returns a non-nil err
301: // with a clear reason. Daily-loss → ForceFlat; profit-target / max-trades →
302: // BlockEntry. NB: this controls ONLY the prop-firm guardrails — it can never
303: // affect the SIM-only / live-account block (that is enforced separately in the
304: // broker layer and is untoggleable).
305: func (g DailyGuardrails) Check() (RiskLimitDecision, error) {
306: 	if !g.MasterEnabled {
307: 		return RiskAllow, nil
308: 	}
309: 	if g.DailyLossEnabled && g.DailyLossLimitUSD > 0 && g.DailyRealizedPnL <= -g.DailyLossLimitUSD {
310: 		return RiskForceFlat, fmt.Errorf("daily loss limit hit (realized today=%.2f, limit=-%.2f)", g.DailyRealizedPnL, g.DailyLossLimitUSD)
311: 	}
312: 	if g.DailyProfitEnabled && g.DailyProfitTargetUSD > 0 && g.DailyRealizedPnL >= g.DailyProfitTargetUSD {
313: 		return RiskBlockEntry, fmt.Errorf("daily profit target reached (realized today=%.2f, target=%.2f)", g.DailyRealizedPnL, g.DailyProfitTargetUSD)
314: 	}
315: 	if g.MaxDailyTradesEnabled && g.MaxDailyTrades > 0 && g.TradesToday >= g.MaxDailyTrades {
316: 		return RiskBlockEntry, fmt.Errorf("max daily trades reached (today=%d, max=%d)", g.TradesToday, g.MaxDailyTrades)
317: 	}
318: 	return RiskAllow, nil
319: }
