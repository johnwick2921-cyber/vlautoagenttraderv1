981: // limitMarketableWrongSide (E7 incident guard, pure) reports whether price has
982: // already traded THROUGH a resting limit in the trade's direction — i.e. a
983: // long's entry sits above the market (buy limit marketable) or a short's entry
984: // sits below it. Placing in that state fills instantly at a worse price.
985: func limitMarketableWrongSide(price, entry float64, side string) bool {
986: 	if price <= 0 || entry <= 0 {
987: 		return false
988: 	}
989: 	switch strings.ToLower(strings.TrimSpace(side)) {
990: 	case "long":
991: 		return price < entry
992: 	case "short":
993: 		return price > entry
994: 	}
995: 	return false
996: }
