[Unit]
Description=nofx SQLite auto-backup timer — 05:00 + 17:30 CT, twice daily (C1)

[Timer]
# The host runs in America/Chicago, so these calendar times ARE CT. 05:00 is a
# quiet pre-open window; 17:30 is just after the 17:00 CME session rollover.
OnCalendar=*-*-* 05:00:00
OnCalendar=*-*-* 17:30:00
# Run a missed backup as soon as possible (laptop asleep at the scheduled time).
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
