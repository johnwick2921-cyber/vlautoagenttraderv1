# UPDATER-USABLE-V1 — the updater worker as a systemd --user unit.
#
# NOT in nofx.service's cgroup: nofx.service is a SYSTEM unit; this is a USER
# unit — a separate cgroup tree by construction, and no Slice= is pinned here.
# The worker's own process check also REFUSES to run inside the bot's cgroup
# (internal/updaterworker/host_os.go CheckProcess, ErrBotCgroup) and with TZ
# set (ErrTZ) — UnsetEnvironment=TZ below keeps that check honest.
#
# Installed by deploy/install-updater-worker.sh (no sudo, builds from a named
# clean sha). The env file is %h/.config/nofx-updater/env, mode 0600, holding
# NOFX_RELEASE_DIR (absolute, outside %h/nofx) and NOFX_CUTOVER_TOKEN (a
# gate-jwt with a 24-hour lifetime — refresh it before each attended install
# window; no longer-lived token type exists).
[Unit]
Description=nofx updater worker (W-ONE-BUTTON M4/M5)
Documentation=file://%h/nofx/docs/superpowers/runbooks/2026-09-27-one-button-update.md

[Service]
Type=simple
ExecStart=%h/bin/nofx-updater --install-dir %h/nofx serve
EnvironmentFile=%h/.config/nofx-updater/env
UnsetEnvironment=TZ

[Install]
WantedBy=default.target
