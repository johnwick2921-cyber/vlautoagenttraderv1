# UPDATER-USABLE-V1 — the updater worker as a systemd --user unit.
#
# NOT in vl.service's cgroup: vl.service is a SYSTEM unit; this is a USER
# unit — a separate cgroup tree by construction, and no Slice= is pinned here.
# The worker's own process check also REFUSES to run inside the bot's cgroup
# (internal/updaterworker/host_os.go CheckProcess, ErrBotCgroup) and with TZ
# set (ErrTZ) — UnsetEnvironment=TZ below keeps that check honest.
#
# Installed by deploy/install-updater-worker.sh (no sudo, builds from a named
# clean sha). The env file is %h/.config/vl-updater/env, mode 0600, holding
# VL_RELEASE_DIR (absolute, outside %h/vl) and VL_CUTOVER_TOKEN (a gate-jwt
# with a 24-hour lifetime — refresh it before each attended install window;
# no longer-lived token type exists).
[Unit]
Description=vl updater worker (W-ONE-BUTTON M4/M5)
Documentation=file://%h/vl/docs/superpowers/runbooks/2026-09-27-one-button-update.md

[Service]
Type=simple
ExecStart=%h/bin/vl-updater --install-dir %h/vl serve
EnvironmentFile=%h/.config/vl-updater/env
UnsetEnvironment=TZ
# worker-self-update: after a successful swap the worker exits so the unit
# restarts on the new binary — Restart=always is the piece that makes the
# exit mean "restart". The worker warns at boot when its self-update knob is
# on but the running unit's Restart is not always/on-success.
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
